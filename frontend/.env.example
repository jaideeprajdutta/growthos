# GrowthOS frontend environment.
#
# NEXT_PUBLIC_API_BASE_URL — the backend the browser client calls.
# Defaults to the development backend; set it when the backend runs on another port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8300

# CORS for the development frontend origin is configured on the backend
# (backend/.env.example: CORS_ORIGINS) — include http://localhost:3101 when the
# frontend runs there (the Playwright E2E config does this automatically).
