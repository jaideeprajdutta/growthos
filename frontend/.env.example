# GrowthOS frontend environment.
#
# NEXT_PUBLIC_API_BASE_URL — the backend the browser calls. In production this
# is the HTTPS URL of the deployed FastAPI service; the browser never receives
# database credentials or AI keys.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8300

# Example production value:
# NEXT_PUBLIC_API_BASE_URL=https://growthos-api.onrender.com

# The backend CORS_ORIGINS must include the exact frontend origin (including
# its https:// scheme). See backend/.env.example and docs/DEPLOYMENT.md.
