# GrowthOS backend environment. See README for full setup instructions.
#
# Required — the database connection. With the development PostgreSQL from
# docker-compose.yml (open the repo root with `docker compose up db`):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growthos

# Optional overrides (defaults in parentheses):
# CORS_ORIGINS=http://localhost:3000
# LOG_LEVEL=INFO

# AI provider — enables AI-dependent features (intelligence reports,
# diagnostics, opportunity generation). Providers: "openai" or "anthropic".
# AI_PROVIDER=openai
# The API key is read from AI_API_KEY, or the provider-specific
# OPENAI_API_KEY / ANTHROPIC_API_KEY. AI_MODEL is optional (provider default).
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=
# Without a configured provider, those endpoints return 503 with a clear
# "AI provider is not configured" message; research and evidence stay usable.
