# GrowthOS backend environment. See README and docs/DEPLOYMENT.md for setup.
#
# Required — use the pooled Postgres connection string in production.
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growthos

# ENVIRONMENT=production enforces explicit HTTPS CORS origins and hides /docs.
# ENVIRONMENT=development
# CORS_ORIGINS=https://your-frontend.vercel.app
# LOG_LEVEL=INFO
# SESSION_TTL_HOURS=168
# ALLOW_REGISTRATION=true

# Set only if API documentation must be reachable in production.
# ENABLE_API_DOCS=false

# AI provider — optional. Without credentials, AI endpoints return 503 and the
# rest of GrowthOS remains fully functional.
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=
